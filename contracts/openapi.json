  "components": {
    "schemas": {
      "ASTResult": {
        "properties": {
          "drug_code": {
            "type": "string",
            "title": "Drug Code"
          },
          "mic": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Mic"
          },
          "comparator": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "=",
                  "<",
                  "<=",
                  ">",
                  ">="
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Comparator"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "reported_sir": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "S",
                  "I",
                  "R"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported Sir"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method"
          },
          "standard": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standard"
          },
          "standard_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standard Version"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "drug_code"
        ],
        "title": "ASTResult"
      },
      "Allergies": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "known_none",
              "known_present",
              "unknown"
            ],
            "title": "Status"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AllergyItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Allergies"
      },
      "AllergyItem": {
        "properties": {
          "drug_code": {
            "type": "string",
            "title": "Drug Code"
          },
          "reaction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reaction"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "drug_code"
        ],
        "title": "AllergyItem"
      },
      "BenchmarkBody": {
        "properties": {
          "case_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Case Ids"
          },
          "modes": {
            "items": {
              "type": "string",
              "enum": [
                "rule-only",
                "rag-only",
                "single-agent",
                "multi-agent"
              ]
            },
            "type": "array",
            "title": "Modes"
          },
          "provider_kind": {
            "type": "string",
            "enum": [
