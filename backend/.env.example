LLM_PROVIDER=unconfigured
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# v2 defaults share the existing model/key. Optional model overrides per agent.
# LLM_V2_CASE_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_AST_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_EVIDENCE_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_CLINICAL_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_SYNTHESIS_AGENT_MODEL=gpt-4.1-mini
LLM_V2_MAX_CALLS=8
LLM_V2_MAX_RETRIES=1
LLM_V2_TIMEOUT_SECONDS=120
LLM_V2_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Provider adapter aliases (same values, retained for backwards compatibility)
LLM_TIMEOUT=20
LLM_RETRIES=2
PROTOTYPE_DB_PATH=../data/runtime/prototype.db

# RAG is independent of the LLM used to generate answers.
RAG_RETRIEVAL_MODE=embedding
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT=30
