LLM_PROVIDER=unconfigured
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# v2 defaults share the existing model/key. Optional model overrides per agent.
# LLM_V2_CASE_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_AST_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_EVIDENCE_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_CLINICAL_AGENT_MODEL=gpt-4.1-mini
# LLM_V2_SYNTHESIS_AGENT_MODEL=gpt-4.1-mini
LLM_V2_MAX_CALLS=8
LLM_V2_MAX_RETRIES=1
LLM_V2_TIMEOUT_SECONDS=120
LLM_V2_MAX_OUTPUT_TOKENS=2000
# Current agent-led budgets are independent of historical V2 settings above.
# Six roles, each with up to three repairs; explicit smaller limits are honored.
LLM_AGENT_LED_MAX_CALLS=40
# Per drug, separate limits for row repair and citation repair; total calls still apply.
LLM_AGENT_LED_MAX_RETRIES=3
LLM_AGENT_LED_TIMEOUT_SECONDS=1200
LLM_AGENT_LED_ROLE_TIMEOUT_SECONDS=300
LLM_AGENT_SYNTHESIS_TIMEOUT_SECONDS=600
LLM_AGENT_AUDIT_TIMEOUT_SECONDS=900
LLM_AGENT_LED_MAX_INPUT_CHARS=1000000
LLM_AGENT_EVIDENCE_TEXT_CHARS=500000
LLM_AGENT_EVIDENCE_CONTEXT_CHARS=750000
LLM_AGENT_RETRIEVAL_MAX_DRUGS=30
LLM_AGENT_DRUG_SEARCH_HITS=4
LLM_AGENT_INFECTION_SEARCH_HITS=12
LLM_AGENT_GUIDELINE_SEARCH_HITS=8
LLM_AGENT_VALIDATION_FEEDBACK_ITEMS=200
# GPT-4.1-mini supports at most 32768 output tokens per call.
LLM_AGENT_LED_MAX_OUTPUT_TOKENS=16384
LLM_AGENT_SYNTHESIS_MAX_OUTPUT_TOKENS=32768
LLM_AGENT_AUDIT_MAX_OUTPUT_TOKENS=32768
LLM_AGENT_STRUCTURED_OUTPUTS=true
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# Provider adapter aliases (same values, retained for backwards compatibility)
LLM_TIMEOUT=300
LLM_RETRIES=2
PROTOTYPE_DB_PATH=../data/runtime/prototype.db

# RAG is independent of the LLM used to generate answers.
RAG_RETRIEVAL_MODE=embedding
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT=180
